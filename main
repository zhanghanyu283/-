import tkinter as tk
import ctypes
import threading
import time
import pyautogui
import keyboard

# ================== 可调参数 ==================
CLICK_INTERVAL = 3     # 点击间隔（秒）
WINDOW_SIZE = 30          # 悬浮图标尺寸（像素）
CIRCLE_RADIUS = 12        # 圆形指示点半径
# =============================================

class FloatingClicker:
    def __init__(self, root):
        self.root = root
        self.clicking = False
        self.movable = False
        self.click_thread = None
        self.stop_event = threading.Event()

        # 创建无边框、置顶、透明背景的悬浮窗
        self.win = tk.Toplevel(root)
        self.win.overrideredirect(True)
        self.win.attributes('-topmost', True)
        self.win.attributes('-transparentcolor', 'white')
        self.win.configure(bg='white')
        self.win.geometry(f'{WINDOW_SIZE}x{WINDOW_SIZE}+100+100')

        # 绘制一个红色圆点作为指示图标
        self.canvas = tk.Canvas(self.win, width=WINDOW_SIZE, height=WINDOW_SIZE,
                                bg='white', highlightthickness=0)
        self.canvas.pack()
        self.circle = self.canvas.create_oval(2, 2, WINDOW_SIZE-2, WINDOW_SIZE-2,
                                              fill='red', outline='red')

        # 默认鼠标穿透（点击会落到下层窗口）
        self.set_clickthrough(True)

        # 绑定拖拽事件（只在移动模式下生效）
        self.win.bind('<Button-1>', self.start_drag)
        self.win.bind('<B1-Motion>', self.on_drag)
        self.win.bind('<ButtonRelease-1>', self.stop_drag)
        self.drag_offset_x = 0
        self.drag_offset_y = 0

    def set_clickthrough(self, enable):
        """启用/禁用鼠标穿透"""
        hwnd = ctypes.windll.user32.GetParent(self.win.winfo_id())
        GWL_EXSTYLE = -20
        WS_EX_TRANSPARENT = 0x20
        style = ctypes.windll.user32.GetWindowLongW(hwnd, GWL_EXSTYLE)
        if enable:
            style |= WS_EX_TRANSPARENT
        else:
            style &= ~WS_EX_TRANSPARENT
        ctypes.windll.user32.SetWindowLongW(hwnd, GWL_EXSTYLE, style)
        # 保持白色区域透明
        ctypes.windll.user32.SetLayeredWindowAttributes(hwnd, 0xFFFFFF, 0, 1)
        # 更新鼠标样式
        self.win.config(cursor='fleur' if not enable else '')

    def start_drag(self, event):
        if not self.movable:
            return
        self.drag_offset_x = event.x
        self.drag_offset_y = event.y

    def on_drag(self, event):
        if not self.movable:
            return
        x = self.win.winfo_x() + event.x - self.drag_offset_x
        y = self.win.winfo_y() + event.y - self.drag_offset_y
        self.win.geometry(f'+{x}+{y}')

    def stop_drag(self, event):
        if not self.movable:
            return
        # 松开鼠标自动固定（退出移动模式）
        self.set_movable(False)

    def set_movable(self, state):
        """切换移动模式（state=True 可拖动）"""
        self.movable = state
        self.set_clickthrough(not state)   # 可拖动时必须关闭穿透
        print(f"移动模式：{'开启（可拖拽）' if state else '关闭（已固定）'}")

    def get_center(self):
        """返回图标中心的屏幕坐标"""
        x = self.win.winfo_x() + WINDOW_SIZE // 2
        y = self.win.winfo_y() + WINDOW_SIZE // 2
        return x, y

    def toggle_click(self):
        if self.clicking:
            self.stop_click()
        else:
            self.start_click()

    def start_click(self):
        if self.clicking:
            return
        self.clicking = True
        self.stop_event.clear()
        self.click_thread = threading.Thread(target=self._click_loop, daemon=True)
        self.click_thread.start()
        print("▶ 连点已启动，点击位置：图标中心")

    def stop_click(self):
        if not self.clicking:
            return
        self.clicking = False
        self.stop_event.set()
        if self.click_thread and self.click_thread.is_alive():
            self.click_thread.join(timeout=1)
        self.click_thread = None
        print("⏹ 连点已停止")

    def _click_loop(self):
        while not self.stop_event.is_set():
            cx, cy = self.get_center()
            pyautogui.click(cx, cy)
            time.sleep(CLICK_INTERVAL)

    def quit(self):
        self.stop_click()
        self.win.destroy()
        self.root.quit()
        keyboard.unhook_all()  # 清理热键

def main():
    root = tk.Tk()
    root.withdraw()  # 隐藏主窗口

    floater = FloatingClicker(root)

    # 热键定义
    keyboard.add_hotkey('ctrl + a', lambda: root.after(0, floater.toggle_click))  # 开始/停止连点
    keyboard.add_hotkey('ctrl + b', lambda: root.after(0, floater.set_movable, not floater.movable))  # 切换移动模式
    keyboard.add_hotkey('esc', lambda: root.after(0, floater.quit))        # 退出

    print("悬浮连点器已启动")
    print("c + a：开始 / 停止连点")
    print("c + b：切换移动模式（开启后可拖拽红色圆点到任意位置，拖拽后自动固定）")
    print("Esc：退出程序")
    print("点击位置 = 红色圆点的中心\n")

    pyautogui.FAILSAFE = False  # 关闭故障安全防护，避免意外中断
    root.mainloop()

if __name__ == '__main__':
    main()
